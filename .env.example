# --- LLM: Gemini is primary, Qwen is the automatic fallback ---
# Required. Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, defaults to gemini-3.1-flash-lite
GEMINI_MODEL=

# Required. DashScope (Alibaba Cloud) key: https://dashscope-intl.console.aliyun.com/
QWEN_API_KEY=
# Optional overrides
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional LLM request tuning
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# --- Code execution sandbox ---
# Required. E2B API key: https://e2b.dev/dashboard
E2B_API_KEY=

# --- Kaggle (only needed for the "kaggle:owner/dataset" input mode) ---
# From kaggle.com > Settings > API > Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
